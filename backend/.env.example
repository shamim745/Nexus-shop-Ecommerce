NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ecommerce

# Auth (use long random strings in production: `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookies / CORS
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# SMTP (optional in development — reset links are logged to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Shop <no-reply@shop.local>"

# Seed admin (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@shop.com
SEED_ADMIN_PASSWORD=Admin@12345
